# Godot 4+ specific ignores
.godot/
/android/
*.translation

# C# / .NET (generated when first script is added)
.mono/
*.csproj.user
bin/
obj/

# Local archive of source bundles — keep out of git
_archive/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
# Python caches
__pycache__/
*.py[cod]

# Bootstrapped Godot API doc source (regenerate via ensure_doc_api.sh)
.claude/skills/godot-api/doc_source/godot/

# Python test cache
.pytest_cache/

# Local agent workflow and secrets (not shared canon)
.omx/
.secrets/
omx_wiki/

# Visual capture outputs (regenerate via scripts/capture_*.sh)
screenshots/

# CI / local build outputs
build/
# D4 Meshy→Blender pipeline artifacts (committed; not the Godot CI build/)
!game/assets/build/
!game/assets/build/**
reports/
.nuget/

# Machine-local capture config
.capture/env

# Generated art/pixellab preview logs + run artifacts (regenerable, not source)
art/**/*.log
art/**/preview/candidates/*/*.log
art/**/preview/candidates/*/*.txt
art/**/preview/candidates/*/*.exitcode
art/**/preview/candidates/*/*.json
art/**/preview/candidates/*/*.md
art/**/preview/candidates/*/*.sha256
art/**/_drafts/source_intake/*/*.log
art/**/_drafts/source_intake/*/*.txt
art/**/_drafts/source_intake/*/*.json
art/**/_drafts/source_intake/*/*.md
art/**/_drafts/source_intake/*/*.sha256

# Local cruft (root has no package.json; do not ignore all of .claude/)
node_modules/
/package-lock.json
.scratch/
.claude/worktrees/
